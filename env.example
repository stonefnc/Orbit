# Copy to `.env.local` for local development (file is gitignored).
# Easier: the app's Keys menu (key icon in the top bar) saves most of these for you.
# Server-side secrets: NEVER prefix with VITE_ (every VITE_ value is copied into the browser bundle and the dev page).
# The plane API (`server/index.ts`) loads `.env` then `.env.local` via `dotenv` (paths relative to repo root).

# --- Server (Node API: `server/index.ts`, default port 8787) ---
PLANE_API_PORT=8787

# Vite dev: where to proxy `/api` (default http://127.0.0.1:8787)
PLANE_API_TARGET=http://127.0.0.1:8787

# The API spends your provider quotas, so it listens on loopback only by default.
# Set to 0.0.0.0 only if you deliberately want LAN access.
# PLANE_API_HOST=127.0.0.1

# Wikimedia Commons API — recommended descriptive User-Agent (https://meta.wikimedia.org/wiki/User-Agent_policy)
WIKIMEDIA_USER_AGENT=OrbitLocal/1.0 (contact: you@example.com)

# --- Optional keys (server only; AISStream, OpenSky, ADS-B Exchange, KeepTrack and FIRMS can also be saved from the Keys menu) ---
# Never name a secret VITE_..._KEY or VITE_..._SECRET: vite.config.ts keeps those names out of the browser anyway.
# OpenSky Network — OAuth2 client credentials (recommended for /api/states/all credit limits).
# Register at https://opensky-network.org/ — keys stay on the server only.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ADS-B Exchange — optional v2 lat/lon/dist feed (personal / licensed use per their terms).
# Header: api-auth. See https://www.adsbexchange.com/data/
ADSBX_API_KEY=

# AISStream — ships (SHP layer); the browser connects to `/api/ais/stream` (see https://aisstream.io/documentation ).
AISSTREAM_API_KEY=

# KeepTrack — a fuller satellite catalog (https://keeptrack.space/). Server only: the browser's KeepTrack source asks the
# server (`/api/keeptrack`), which adds this key. Do NOT name it VITE_KEEPTRACK_API_KEY: that would ship it in the browser.
KEEPTRACK_API_KEY=

# NASA FIRMS MAP_KEY — satellite-detected wildfires (https://firms.modaps.eosdis.nasa.gov/api/map_key/).
# Optional: the fires layer falls back to NASA EONET without it.
FIRMS_MAP_KEY=

# Aviationstack — airline flight lookup (still via the Vite dev proxy; the key stays on this PC).
AVIATIONSTACK_ACCESS_KEY=

# Notable aircraft: weekly import of the plane-alert-db community list. NOTABLE_IMPORT=off turns it off (default on).
# NOTABLE_IMPORT=on
# Pipe-separated plane-alert-db categories to import (default "Don't you know who I am?").
# NOTABLE_CATEGORIES=

# --- Browser settings (VITE_*: visible in the browser; never put a secret here) ---
# Cesium ion token (a browser token by design): sharper imagery, terrain and the 3D Photo map. The Keys menu can set it too.
VITE_CESIUM_ION_TOKEN=
# Photorealistic 3D Tiles (Cesium Ion asset id). Enables PHR · ON toggle when set.
# Example: VITE_PHOTOREALISTIC_3D_ASSET_ID=1234567
VITE_PHOTOREALISTIC_3D_ASSET_ID=
# The N2YO key has no setting here on purpose: paste it in the Keys menu (it stays in your browser only).

# Only when you intentionally need a non-default production base:
# VITE_PLANE_API_BASE=https://your-api.example.com
# Minimum ms between aircraft polls (default 5000; anything below 2000 is raised to 2000).
# VITE_PLANE_POLL_MS=5000
# Relay for CelesTrak in production (an absolute URL is used as-is). The server normally fetches the catalog for you.
# VITE_CELESTRAK_API_BASE=

# Aviationstack flight lookup, browser side. Production needs an HTTPS relay that adds the access key.
# VITE_AVIATIONSTACK_API_BASE=
# off | fallback (default) | preferred
# VITE_AVIATIONSTACK_MODE=fallback
# Set 0 or false to turn off the few-requests mode (more API calls).
# VITE_AVIATIONSTACK_SPARING=1
# Memo time for route lookups in ms (default 7 days).
# VITE_AVIATIONSTACK_CACHE_MS=604800000

# --- ALPR cameras and data centers (see ALPR_ADAPTER.md) ---
# Default: OpenStreetMap through the server's tile cache (`/api/alpr`, and `/api/datacenters` for data centers). Zoom in
# with ALPR ON. Nothing to configure. The settings below choose older, browser-side sources and are rarely needed.
# Offline sample GeoJSON instead:
# VITE_ALPR_ADAPTER=geojson
# VITE_ALPR_DATA_URL=/data/alpr-sample.geojson
#
# Browser-side Overpass instead of the server tiles (ODbL — https://www.openstreetmap.org/copyright ):
# VITE_ALPR_VIEWPORT=0
# VITE_ALPR_ADAPTER=overpass
# VITE_ALPR_OVERPASS_QUERY_URL=/data/my-region.ql
# Or a one-line Overpass QL (wins over the query file):
# VITE_ALPR_OVERPASS_QUERY=
# VITE_ALPR_OVERPASS_INTERPRETER=https://overpass-api.de/api/interpreter
#
# FlockHopper-style public GeoJSON (see ALPR_ADAPTER.md — large file, check CORS / proxy):
# VITE_ALPR_ADAPTER=geojson
# VITE_ALPR_DATA_URL=/flockhopper-data/cameras.geojson.gz
# Or direct (needs CORS from origin): https://data.dontgetflocked.com/cameras.geojson.gz

# --- Camera layer (CAM · ON) ---
# Default: real public agency cameras through the server (`/api/cctv`; Georgia, California, London, BC, Austin and more).
# Nothing to configure. Older modes, set VITE_EARTHCAM_ADAPTER to one of:
#   network (EarthCam location pins, links only), osm (the same plus OSM tags), static (bundled seed JSON).
# Unset or `cctv` is the default above.
# VITE_EARTHCAM_ADAPTER=network
# VITE_EARTHCAM_NETWORK_API_URL=/earthcam-api-proxy/api/mapsearch/get_locations_network.php?a=fetch&r=ecn
# VITE_EARTHCAM_LOCATIONS_API_URL=/earthcam-api-proxy/api/mapsearch/get_locations.php?a=fetch
# Largest view span (degrees) before the OSM camera query runs (default 4; accepted 0.5-15):
# VITE_EARTHCAM_VIEWPORT_MAX_DEG=4
# VITE_EARTHCAM_OVERPASS_INTERPRETER=/overpass-proxy/api/interpreter
# VITE_EARTHCAM_DATA_URL=/data/earthcam-cameras.json

# ALPR “Fly globe to” uses OSM Nominatim — dev proxies /nominatim-proxy with an Orbit User-Agent. Prod: same-origin relay if needed:
# VITE_NOMINATIM_API_BASE=https://your-host.example/nominatim
# Optional: ms between geocode requests (default 1000; clamped 400–2000). Lower only if you self-host Nominatim.
# VITE_NOMINATIM_MIN_INTERVAL_MS=1000
